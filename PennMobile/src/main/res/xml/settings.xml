<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:scrollbars="none">

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="Account">
        <Preference
            android:id="@+id/pref_account_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:key="pref_account_edit"
            android:summary="Modify your name and email"
            android:title="Edit your profile"
            app:iconSpaceReserved="false" />
        <Preference
            android:id="@+id/pref_account_login_logout"
            android:key="pref_account_login_logout"
            android:title="Log In"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/home_bar_customization">

        <Preference
            app:iconSpaceReserved="false"
            app:key="pref_home_bar_tabs"
            app:summary="@string/home_bar_tabs_dialog"
            app:title="@string/home_bar_tabs" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:key="pref_features"
        app:title="Features" />

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="Links">


        <Preference
            android:id="@+id/pref_labs_link"
            app:iconSpaceReserved="false"
            app:key="pref_labs_link"
            app:title="Penn Labs" />
        <Preference
            android:id="@+id/pref_feedback_link"
            app:iconSpaceReserved="false"
            app:key="pref_feedback_link"
            app:title="Feedback" />
        <Preference
            android:id="@+id/pref_penn_link"
            app:iconSpaceReserved="false"
            app:key="pref_penn_link"
            app:title="Penn Homepage" />
        <Preference
            android:id="@+id/pref_campus_express_link"
            app:iconSpaceReserved="false"
            app:key="pref_campus_express_link"
            app:title="Campus Express" />
        <Preference
            android:id="@+id/pref_canvas_link"
            app:iconSpaceReserved="false"
            app:key="pref_canvas_link"
            app:title="Canvas" />
        <Preference
            android:id="@+id/pref_path_at_penn_link"
            app:iconSpaceReserved="false"
            app:key="pref_path_at_penn_link"
            app:title="Path@Penn" />
        <Preference
            android:id="@+id/pref_penn_portal_link"
            app:iconSpaceReserved="false"
            app:key="pref_penn_portal_link"
            app:title="Penn Portal" />


    </PreferenceCategory>

</PreferenceScreen>